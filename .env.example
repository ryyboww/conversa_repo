# Hosted contribution checkout URLs.
# These are public links (for example Stripe Payment Links), not secret API keys.
PUBLIC_SUPPORT_PROVIDER_LABEL=Stripe
PUBLIC_SUPPORT_ONE_TIME_URL=
PUBLIC_SUPPORT_MONTHLY_URL=

# Optional privacy-friendly analytics. Leave blank to disable.
PUBLIC_PLAUSIBLE_DOMAIN=

# Optional secure client-portal handoff. Use only a public HTTPS sign-in URL.
# Never place portal API keys or authentication secrets here.
PUBLIC_CLIENT_PORTAL_PROVIDER_LABEL=
PUBLIC_CLIENT_PORTAL_URL=
