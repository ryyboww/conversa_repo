# Convera Strategies — public build configuration
# These values may be exposed in generated browser output. Never place secrets here.

PUBLIC_SUPPORT_PROVIDER_LABEL=
PUBLIC_SUPPORT_ONE_TIME_URL=
PUBLIC_SUPPORT_MONTHLY_URL=
PUBLIC_PLAUSIBLE_DOMAIN=

# Optional secure client-portal handoff. Leave blank until an authenticated provider is selected.
PUBLIC_CLIENT_PORTAL_PROVIDER_LABEL=
PUBLIC_CLIENT_PORTAL_URL=
