const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Convera Strategies Services',
  itemListElement: serviceAreas.map((area, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: area.title,
      description: area.description,
      provider: { '@type': 'Organization', name: site.name, url: site.url },
      url: new URL(`/services/#${area.id}`, site.url).toString()
    }
  }))
};
