      </div>
    </div>
  </section>

  <section class="section speaking-formats">
    <div class="container grid-2">
      <div>
        <p class="eyebrow">Formats</p>
        <h2>Flexible by setting.</h2>
        <ul class="speaking-list"><li>Keynotes and invited talks</li><li>Panels and moderated conversations</li><li>Podcasts, radio, and media interviews</li><li>University and classroom visits</li><li>Professional workshops and facilitated discussions</li><li>Research presentations and public scholarship events</li></ul>
      </div>
      <div>
        <p class="eyebrow">Media</p>
        <h2>For journalists and producers.</h2>
        <p class="lede">For interview requests, background conversations, commentary related to Ryan’s published work, or requests for biography and approved descriptive materials, identify the outlet, topic, and deadline.</p>
        <div class="speaking-actions"><a class="button button--primary" href="/contact/?reason=speaking-media&source=media-page">Media inquiry →</a><a class="button button--ghost" href="/press-kit/">Biography & fact sheet</a></div>
      </div>
    </div>
  </section>

  <style>
    .speaking-note{padding:1.25rem 1.35rem;background:color-mix(in srgb,var(--surface) 92%,transparent);}
    .speaking-note p:last-child{margin-top:.55rem;color:var(--muted);font-size:.92rem;}
    .topic-grid article{padding:1.5rem;min-height:220px;}
    .topic-grid p{margin-top:.65rem;color:var(--muted);}
    .speaking-gallery{background:var(--bg);border-top:1px solid var(--line);}
    .speaking-gallery__heading{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:2rem;align-items:end;margin-bottom:1.4rem;}
    .speaking-gallery__heading h2{margin:.45rem 0 0;}
    .speaking-gallery__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;}
    .speaking-gallery__grid figure{margin:0;overflow:hidden;border-radius:12px;background:var(--surface-soft);}
    .speaking-gallery__grid img{width:100%;aspect-ratio:16/9;object-fit:cover;}
    .speaking-formats{background:var(--surface-soft);border-block:1px solid var(--line);}
    .speaking-formats h2{margin:.45rem 0 .8rem;}
    .speaking-list{margin:0;padding-left:1.2rem;display:grid;gap:.6rem;color:var(--muted);}
    .speaking-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.2rem;}
    @media(max-width:760px){.speaking-gallery__heading,.speaking-gallery__grid{grid-template-columns:1fr;}}
  </style>
</BaseLayout>
