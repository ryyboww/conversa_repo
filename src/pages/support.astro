---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommercialCTA from '../components/shared/CommercialCTA.astro';
import { supportPaymentOptions, supportCheckout } from '../config/support';
---
<BaseLayout title="Support" description="Support Convera Strategies and its publications, community engagement, public-facing work, and mission." canonical="/support/">
  <header class="support-hero">
    <div class="container support-hero__grid">
      <div>
        <p class="eyebrow">Support the Work</p>
        <h1>Support a person, a mission, and a different way of approaching problems.</h1>
        <p class="lede">Contributions help sustain founder-led public work, publications, community participation, and the infrastructure Convera needs to keep developing independently.</p>
      </div>
      <div class="support-hero__statement">
        <span>Why it matters</span>
        <strong>Protecting and strengthening our institutions is an investment in what comes next.</strong>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container support-intro">
      <p class="eyebrow">Contribute</p>
      <h2>Choose the level of support that makes sense for you.</h2>
      <p class="lede">Contributions are voluntary support for Convera’s public-facing mission. They are separate from fees paid for professional services.</p>
    </div>
    <div class="container grid-2 support-options" id="support-options">
      {supportPaymentOptions.map((option) => (
        <article class="card support-option">
          <p class="eyebrow">{option.eyebrow}</p>
          <h3>{option.title}</h3>
          <p class="muted">{option.description}</p>
          <p class="support-option__amounts">{option.suggestedAmounts.join(' · ')}</p>
          {option.url ? (
            <a class="button button--primary" href={option.url} target="_blank" rel="noopener">Continue with {supportCheckout.providerLabel} →</a>
          ) : (
            <a class="button button--ghost" href={`mailto:${supportCheckout.contactEmail}?subject=Supporting Convera Strategies`}>Ask About Supporting Convera →</a>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="section support-impact">
    <div class="container grid-3">
      <article><p class="eyebrow">Publications</p><h3>Make room for thoughtful work.</h3><p class="muted">Support helps create time and infrastructure for essays, analysis, and public-facing publications.</p></article>
      <article><p class="eyebrow">Community</p><h3>Keep conversation open.</h3><p class="muted">Support helps maintain pathways for observations, questions, recommendations, and public participation.</p></article>
      <article><p class="eyebrow">Institutions</p><h3>Invest in what comes next.</h3><p class="muted">Convera’s mission is grounded in the belief that stronger institutions help create a more resilient future.</p></article>
    </div>
  </section>

  <section class="section--tight support-services">
    <div class="container">
      <CommercialCTA compact />
    </div>
  </section>

  <section class="section--tight support-notice">
    <div class="container">
      <p>Contributions support Convera Strategies’ publications, public-facing work, community engagement, and organizational development. Convera Strategies is not presented as a charitable organization, and contributions are not represented as tax-deductible charitable donations. Professional services are separate paid engagements and are described on the Services page.</p>
    </div>
  </section>

  <style>
    .support-hero { padding:clamp(4.5rem,8vw,7.5rem) 0;color:#fff;background:linear-gradient(120deg,#062633 0%,#0a4554 62%,#176978 100%); }
    .support-hero .eyebrow{color:#72deea;}
    .support-hero__grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.65fr);gap:clamp(2rem,6vw,6rem);align-items:center;}
    .support-hero h1{max-width:13ch;}
    .support-hero .lede{margin-top:1.4rem;color:rgba(255,255,255,.82);}
    .support-hero__statement{padding:1.6rem;border-left:2px solid #72deea;background:rgba(3,28,38,.3);}
    .support-hero__statement span{display:block;color:#72deea;font-size:.7rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;}
    .support-hero__statement strong{display:block;margin-top:.7rem;font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(1.8rem,2.8vw,2.6rem);font-weight:500;line-height:1.08;}
    .support-intro{max-width:820px;margin-bottom:2rem;text-align:center;}
    .support-intro h2{margin:.55rem 0 1rem;}
    .support-intro .lede{margin-inline:auto;}
    .support-options{align-items:stretch;}
    .support-option{padding:clamp(1.6rem,3vw,2.5rem);display:flex;flex-direction:column;}
    .support-option h3{margin:.55rem 0 1rem;font-size:clamp(2rem,3vw,2.8rem);}
    .support-option__amounts{margin-top:1rem;color:var(--accent);font-weight:700;}
    .support-option .button{margin-top:auto;align-self:flex-start;position:relative;top:1.4rem;margin-bottom:1.4rem;}
    .support-impact{background:var(--surface-soft);border-block:1px solid var(--line);}
    .support-impact h3{margin:.5rem 0 .7rem;}
    .support-services{background:var(--bg);}
    .support-notice{border-top:1px solid var(--line);}
    .support-notice p{max-width:72rem;color:var(--muted);font-size:.84rem;}
    @media(max-width:860px){.support-hero__grid{grid-template-columns:1fr;}}
  </style>
</BaseLayout>
