---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CommercialCTA from '../components/shared/CommercialCTA.astro';
import { supportPaymentOptions, supportCheckout } from '../config/support';
---
<BaseLayout title="Support" description="Support Ryan Brown’s independent publications, speaking, public engagement, and work advancing thoughtful institutional change." canonical="/support/">
  <PageHero
    eyebrow="Support"
    title="Help meaningful work move forward."
    lede="Support expands independent research, public scholarship, publications, and conversations capable of strengthening organizations and public life."
  >
    <div slot="aside" class="support-hero__statement">
      <span>Why it matters</span>
      <strong>Readers, collaborators, referrers, and sponsors each help useful ideas reach the people and institutions prepared to act on them.</strong>
    </div>
  </PageHero>

  <section class="section">
    <div class="container support-intro">
      <p class="eyebrow">Why Support Matters</p>
      <h2>There is more than one way to support the work.</h2>
      <p class="lede">Read, share, follow, recommend, collaborate, or introduce Convera to an organization facing a consequential problem. Each action helps strengthen the public work and the relationships through which it can create value.</p>
    </div>
    <div class="container grid-3 support-participation">
      <article class="card"><h3>Read & Share</h3><p class="muted">Read a publication, share an essay, or bring the work into a conversation where it may be useful.</p><a href="/publications/">Explore Publications →</a></article>
      <article class="card"><h3>Connect</h3><p class="muted">Follow Convera, recommend its work, or invite Ryan into a serious professional or public conversation.</p><a href="/follow/">Follow Convera →</a></article>
      <article class="card"><h3>Collaborate</h3><p class="muted">Refer an organization or begin a conversation about research, analysis, strategy, or facilitation.</p><a href="/work-with-convera/">Work With Convera →</a></article>
    </div>
    <div class="container support-sponsorship"><p class="eyebrow">Financial Sponsorship</p><h2>Sponsor Convera’s public work.</h2><p>Financial support helps create time and capacity for independent research, publications, public resources, speaking, and wider engagement. It remains separate from fees for professional services.</p></div>
    <div class="container grid-2 support-options" id="support-options">
      {supportPaymentOptions.map((option) => (
        <article class="card support-option">
          <p class="eyebrow">{option.eyebrow}</p>
          <p class="muted">{option.description}</p>
          <p class="support-option__amounts">{option.suggestedAmounts.join(' · ')}</p>
          {option.url ? (
            <a class="button button--primary" href={option.url} target="_blank" rel="noopener">Continue with {supportCheckout.providerLabel} →</a>
          ) : (
            <a class="button button--ghost" href={`mailto:${supportCheckout.contactEmail}?subject=Supporting Convera Strategies`}>Ask About Supporting Convera →</a>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="section support-impact">
    <div class="container grid-3">
      <article><p class="eyebrow">Publications</p><h3>Develop the argument.</h3><p class="muted">Support creates room for research, essays, analysis, and public-facing work capable of traveling beyond a single conversation.</p></article>
      <article><p class="eyebrow">Public Engagement</p><h3>Carry the idea farther.</h3><p class="muted">Support helps create opportunities to speak, convene, travel, and bring ideas about institutional change into more organizations and public settings.</p></article>
      <article><p class="eyebrow">Institutions</p><h3>Keep the purpose visible.</h3><p class="muted">The work is grounded in the belief that stronger institutions require thoughtful change, sustained attention, and a clear sense of what should be preserved.</p></article>
    </div>
  </section>

  <section class="section--tight support-services">
    <div class="container">
      <CommercialCTA compact />
    </div>
  </section>

  <section class="section--tight support-notice">
    <div class="container">
      <p>Contributions support Ryan Brown’s independent publications, speaking, public-facing work, community engagement, and the broader reach of ideas associated with Convera Strategies. Convera Strategies is not presented as a charitable organization, and contributions are not represented as tax-deductible charitable donations. Professional services are separate paid engagements and are described on the Services page.</p>
    </div>
  </section>

  <style>
    .support-hero__statement{padding:1.25rem 0 1.25rem 1.4rem;border-left:2px solid var(--accent);}
    .support-hero__statement span{display:block;color:var(--accent);font-size:.68rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;}
    .support-hero__statement strong{display:block;margin-top:.65rem;color:var(--text);font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(1.55rem,2.3vw,2.1rem);font-weight:500;line-height:1.08;}
    .support-intro{max-width:820px;margin-bottom:2rem;text-align:center;}
    .support-intro h2{margin:.55rem 0 1rem;}
    .support-intro .lede{margin-inline:auto;}
    .support-options{align-items:stretch;}
    .support-participation{margin-bottom:clamp(3rem,6vw,5rem)}.support-participation article{padding:1.5rem}.support-participation h3{margin:.5rem 0 .7rem}.support-participation a{display:inline-block;margin-top:1rem;color:var(--accent);font-weight:700;text-decoration:none}.support-sponsorship{max-width:820px;margin-bottom:1.6rem;text-align:center}.support-sponsorship p{margin-inline:auto;color:var(--muted)}
    .support-option{padding:clamp(1.6rem,3vw,2.5rem);display:flex;flex-direction:column;}
    .support-option h3{margin:.55rem 0 1rem;font-size:clamp(1.8rem,2.6vw,2.35rem);}
    .support-option__amounts{margin-top:1rem;color:var(--accent);font-weight:700;}
    .support-option .button{margin-top:1.25rem;align-self:flex-start;}
    .support-impact{background:var(--surface-soft);border-block:1px solid var(--line);}
    .support-impact h3{margin:.5rem 0 .7rem;}
    .support-services{background:var(--bg);}
    .support-notice{border-top:1px solid var(--line);}
    .support-notice p{max-width:72rem;color:var(--muted);font-size:.84rem;}
    
  </style>
</BaseLayout>
