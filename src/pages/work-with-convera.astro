---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../config/site';
import { engagementBoundaries, engagementFit } from '../config/engagement';
import { starterEngagements } from '../config/services';

const questions = [
  {
    question: 'Do I need to know exactly which service I need?',
    answer: 'No. A useful first message can simply explain the question, project, decision, or situation you are working through. Convera can help determine whether a defined engagement makes sense.'
  },
  {
    question: 'What happens after I contact Convera?',
    answer: 'Convera reviews the public inquiry first. If more detail is useful, a separate private Intake invitation is sent manually. Intake is not public and is not automatically sent after every Contact submission.'
  },
  {
    question: 'Does submitting a form create a client relationship?',
    answer: 'No. Contact and Intake submissions are administrative steps only. Scope, pricing, and a project agreement are handled separately before work begins.'
  },
  {
    question: 'How are fees and estimates handled?',
    answer: 'When a project appears to fit, Convera can prepare a project-linked estimate or proposal. Commercial acceptance is followed by a separate project agreement; an accepted estimate is not itself the contract.'
  },
  {
    question: 'Can an organization use its own agreement or procurement process?',
    answer: 'Yes. Universities, public agencies, and larger organizations may require their own agreement, purchase-order process, vendor onboarding, or other administrative requirements. Convera can track those as part of project readiness.'
  },
  {
    question: 'What does Convera not provide?',
    answer: 'Convera does not currently provide legal representation, licensed human-resources compliance services, formal employee investigations, emergency response, or clinical services.'
  }
] as const;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};
---
<BaseLayout
  title="Work With Convera"
  description="Begin a focused conversation with Convera Strategies about organizational strategy, workplace culture, communication, research, or a question that deserves a clearer view."
  canonical="/work-with-convera/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <PageHero
    eyebrow="Work With Convera"
    tagline={site.tagline}
    title="Begin with context. Define the next step."
    lede="Convera is built for focused engagements. Start with the project, decision, workplace concern, document, or question that needs attention; the first task is to understand what matters before deciding what kind of work would be useful."
    compact
  >
    <div slot="actions">
      <a class="button button--primary" href="/contact/?reason=professional">Contact Convera →</a>
      <a class="button button--ghost" href="/services/">Explore Services</a>
    </div>
    <aside slot="aside" class="work-hero__aside">
      <span>Founder-led</span>
      <strong>Direct access to the person doing the work.</strong>
      <p>Initial engagements remain intentionally focused, scoped, and manageable.</p>
    </aside>
  </PageHero>

  <section class="section work-fit">
    <div class="container work-fit__grid">
      <div>
        <p class="eyebrow">A Good Starting Point</p>
        <h2>You do not need a polished brief.</h2>
        <p class="lede">A useful first message explains what is happening, why it matters, and what you hope to understand, decide, or improve.</p>
      </div>
      <ul class="fit-list">
        {engagementFit.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section engagement-preview">
    <div class="container">
      <div class="section-intro">
        <p class="eyebrow">Initial Engagements</p>
        <h2>Focused ways to begin.</h2>
        <p class="lede">These are starting points rather than rigid packages. Scope is defined around the question and what can be handled carefully.</p>
      </div>
      <div class="grid-2">
        {starterEngagements.map((item) => (
          <article class="card engagement-card">
            <h3>{item.title}</h3>
            <p class="muted">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section work-process">
    <div class="container work-process__grid">
      <div>
        <p class="eyebrow">How It Begins</p>
        <h2>One clear public entry point.</h2>
        <p class="lede">Professional inquiries begin through Contact. Convera reviews the message before asking for more detailed project information.</p>
      </div>
      <ol class="process-list">
        <li><strong>01</strong><span><b>Contact</b> Share the question, project, or situation in your own words.</span></li>
        <li><strong>02</strong><span><b>Review</b> Convera reviews fit, timing, and what information is actually needed.</span></li>
        <li><strong>03</strong><span><b>Intake invitation</b> If appropriate, a separate private Intake invitation follows.</span></li>
        <li><strong>04</strong><span><b>Defined engagement</b> Scope, estimate, and agreement are handled before work begins.</span></li>
      </ol>
    </div>
  </section>

  <section class="section work-questions" aria-labelledby="work-questions-title">
    <div class="container work-questions__grid">
      <div><p class="eyebrow">Questions & Answers</p><h2 id="work-questions-title">Before you reach out.</h2><p class="lede">A few practical answers about how Convera handles inquiries, estimates, agreements, and project boundaries.</p></div>
      <div class="qa-list">
        {questions.map((item) => (
          <details class="qa-item">
            <summary>{item.question}<span aria-hidden="true">+</span></summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section boundaries">
    <div class="container boundaries__grid">
      <div>
        <p class="eyebrow">Scope Boundaries</p>
        <h2>Clear expectations protect the work.</h2>
        <p class="lede">Convera provides analytical and strategic services. Some matters require licensed or specialized professionals and should be handled elsewhere.</p>
      </div>
      <div class="boundary-card">
        <p>Convera does not currently offer:</p>
        <ul>{engagementBoundaries.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section--tight support-separation">
    <div class="container support-separation__inner">
      <div>
        <p class="eyebrow">Ready to Begin?</p>
        <h2>Start with a concise message.</h2>
        <p>Use the public Contact form first. If additional project information is useful, Convera will send the separate Intake invitation directly.</p>
      </div>
      <a class="button button--primary" href="/contact/?reason=professional">Contact Convera →</a>
    </div>
  </section>

  <style>
    .work-hero__aside{padding:1.25rem 0 1.25rem 1.4rem;border-left:2px solid var(--accent)}
    .work-hero__aside span{color:var(--accent);font-size:.7rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
    .work-hero__aside strong{display:block;margin:.6rem 0;font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(1.55rem,2.25vw,2.05rem);font-weight:500;line-height:1.08}
    .work-hero__aside p{color:var(--muted);font-size:.9rem}
    .work-fit__grid,.work-process__grid,.boundaries__grid,.work-questions__grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(2rem,5vw,5rem);align-items:start}
    .work-fit h2,.work-process h2,.boundaries h2,.work-questions h2{margin:.5rem 0 .85rem}
    .fit-list,.process-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
    .fit-list li{position:relative;padding:1rem 0 1rem 2rem;border-bottom:1px solid var(--line);color:var(--muted)}
    .fit-list li::before{content:'→';position:absolute;left:0;color:var(--accent);font-weight:700}
    .engagement-preview{background:var(--surface-soft);border-block:1px solid var(--line)}
    .engagement-card{padding:1.6rem}.engagement-card p{margin-top:.7rem}
    .process-list li{display:grid;grid-template-columns:42px 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}
    .process-list strong{color:var(--accent);font-size:.7rem;letter-spacing:.12em}.process-list span{color:var(--muted)}.process-list b{display:block;margin-bottom:.18rem;color:var(--text);font-weight:700}
    .work-questions{background:var(--surface-soft);border-block:1px solid var(--line)}
    .qa-list{border-top:1px solid var(--line)}.qa-item{border-bottom:1px solid var(--line)}.qa-item summary{display:flex;justify-content:space-between;gap:1rem;align-items:center;min-height:56px;padding:.8rem 0;cursor:pointer;font-family:"Cormorant Garamond",Georgia,serif;font-size:1.25rem;font-weight:600;list-style:none}.qa-item summary::-webkit-details-marker{display:none}.qa-item summary span{color:var(--accent);font-family:Inter,sans-serif;font-size:1.2rem;font-weight:400;transition:transform 150ms ease}.qa-item[open] summary span{transform:rotate(45deg)}.qa-item p{padding:0 2rem 1rem 0;color:var(--muted);font-size:.94rem}
    .boundary-card{padding:1.5rem;border:1px solid var(--line);background:var(--surface)}.boundary-card p{font-weight:700}.boundary-card ul{margin:1rem 0 0;padding-left:1.2rem;display:grid;gap:.55rem;color:var(--muted)}
    .support-separation{border-top:1px solid var(--line);background:var(--surface-soft)}.support-separation__inner{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:center}.support-separation h2{margin:.4rem 0 .65rem;font-size:clamp(1.75rem,2.8vw,2.45rem)}.support-separation p:not(.eyebrow){max-width:760px;color:var(--muted)}
    @media(max-width:820px){.work-fit__grid,.work-process__grid,.boundaries__grid,.work-questions__grid,.support-separation__inner{grid-template-columns:1fr}.support-separation__inner .button{width:fit-content}}
    @media(max-width:560px){.support-separation__inner .button{width:100%}.qa-item summary{font-size:1.12rem}}
    @media(prefers-reduced-motion:reduce){.qa-item summary span{transition:none}}
  </style>
</BaseLayout>
