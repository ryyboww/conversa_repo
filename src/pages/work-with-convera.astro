---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { engagementBoundaries, engagementFit } from '../config/engagement';
import { starterEngagements } from '../config/services';
---
<BaseLayout
  title="Work With Convera"
  description="Begin a focused conversation with Convera Strategies about organizational strategy, workplace culture, communication, or a difficult problem that deserves a clearer view."
  canonical="/work-with-convera/"
>
  <PageHero
    eyebrow="Work With Convera"
    title="Start with the challenge, not a predetermined solution."
    lede="Convera is built for focused engagements. Begin with the problem, decision, workplace concern, document, or question that needs attention."
  >
    <div slot="actions">
      <a class="button button--primary" href="/contact/?reason=professional">Contact Convera →</a>
      <a class="button button--ghost" href="/services/">Explore Services</a>
    </div>
    <aside slot="aside" class="work-hero__aside">
      <span>Founder-led</span>
      <strong>Direct access to the person doing the work.</strong>
      <p>No handoff to a junior team. Initial engagements remain intentionally focused and manageable.</p>
    </aside>
  </PageHero>

  <section class="section work-fit">
    <div class="container work-fit__grid">
      <div>
        <p class="eyebrow">Good Starting Point</p>
        <h2>You do not need a polished brief.</h2>
        <p class="lede">A useful first message explains what is happening, why it matters, and what you hope to understand or improve.</p>
      </div>
      <ul class="fit-list">
        {engagementFit.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section engagement-preview">
    <div class="container">
      <div class="section-intro">
        <p class="eyebrow">Initial Engagements</p>
        <h2>Focused ways to begin.</h2>
        <p class="lede">These are starting points rather than rigid packages. Scope is defined around the problem and what can be handled carefully.</p>
      </div>
      <div class="grid-2">
        {starterEngagements.map((item) => (
          <article class="card engagement-card">
            <h3>{item.title}</h3>
            <p class="muted">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section work-process">
    <div class="container work-process__grid">
      <div>
        <p class="eyebrow">How It Begins</p>
        <h2>One clear public entry point.</h2>
        <p class="lede">Professional inquiries begin through Contact. Convera reviews the message before asking for more detailed project information.</p>
      </div>
      <ol class="process-list">
        <li><strong>01</strong><span><b>Contact</b> Share the challenge or question in your own words.</span></li>
        <li><strong>02</strong><span><b>Review</b> Convera reviews fit, timing, and what information is actually needed.</span></li>
        <li><strong>03</strong><span><b>Intake invitation</b> If appropriate, a separate private Intake invitation follows.</span></li>
        <li><strong>04</strong><span><b>Defined engagement</b> Scope, estimate, and agreement are handled before work begins.</span></li>
      </ol>
    </div>
  </section>

  <section class="section boundaries">
    <div class="container boundaries__grid">
      <div>
        <p class="eyebrow">Scope Boundaries</p>
        <h2>Clear expectations protect the work.</h2>
        <p class="lede">Convera provides analytical and strategic services. Some matters require licensed or specialized professionals and should be handled elsewhere.</p>
      </div>
      <div class="boundary-card">
        <p>Convera does not currently offer:</p>
        <ul>{engagementBoundaries.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section--tight support-separation">
    <div class="container support-separation__inner">
      <div>
        <p class="eyebrow">Ready to Begin?</p>
        <h2>Start with a concise message.</h2>
        <p>Use the public Contact form first. If additional project information is useful, Convera will send the separate Intake invitation directly.</p>
      </div>
      <a class="button button--primary" href="/contact/?reason=professional">Contact Convera →</a>
    </div>
  </section>

  <style>
    .work-hero__aside{padding:1.25rem 0 1.25rem 1.4rem;border-left:2px solid var(--accent);}
    .work-hero__aside span{color:var(--accent);font-size:.7rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;}
    .work-hero__aside strong{display:block;margin:.6rem 0;font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(1.55rem,2.25vw,2.05rem);font-weight:500;line-height:1.08;}
    .work-hero__aside p{color:var(--muted);font-size:.9rem;}
    .work-fit__grid,.work-process__grid,.boundaries__grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(2rem,5vw,5rem);align-items:start;}
    .work-fit h2,.work-process h2,.boundaries h2{margin:.5rem 0 .85rem;}
    .fit-list,.process-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line);}
    .fit-list li{position:relative;padding:1rem 0 1rem 2rem;border-bottom:1px solid var(--line);color:var(--muted);}
    .fit-list li::before{content:'→';position:absolute;left:0;color:var(--accent);font-weight:700;}
    .engagement-preview{background:var(--surface-soft);border-block:1px solid var(--line);}
    .engagement-card{padding:1.6rem;}.engagement-card p{margin-top:.7rem;}
    .process-list li{display:grid;grid-template-columns:42px 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line);}
    .process-list strong{color:var(--accent);font-size:.7rem;letter-spacing:.12em;}
    .process-list span{color:var(--muted);}.process-list b{display:block;margin-bottom:.18rem;color:var(--text);font-weight:700;}
    .boundary-card{padding:1.5rem;border:1px solid var(--line);background:var(--surface);}
    .boundary-card p{font-weight:700;}.boundary-card ul{margin:1rem 0 0;padding-left:1.2rem;display:grid;gap:.55rem;color:var(--muted);}
    .support-separation{border-top:1px solid var(--line);background:var(--surface-soft);}
    .support-separation__inner{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:center;}
    .support-separation h2{margin:.4rem 0 .65rem;font-size:clamp(1.75rem,2.8vw,2.45rem);}
    .support-separation p:not(.eyebrow){max-width:760px;color:var(--muted);}
    @media(max-width:900px){.work-fit__grid,.work-process__grid,.boundaries__grid,.support-separation__inner{grid-template-columns:1fr}.support-separation__inner .button{width:fit-content}}
    @media(max-width:560px){.support-separation__inner .button{width:100%}}
  </style>
</BaseLayout>
