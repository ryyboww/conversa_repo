---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderPortrait from '../components/home/FounderPortrait.astro';
import SupportPanel from '../components/shared/SupportPanel.astro';
import CommercialCTA from '../components/shared/CommercialCTA.astro';
import { site, legacyQuote } from '../config/site';
import { featuredPublication, publicationRecordHref } from '../config/publications';
import { serviceAreas } from '../config/services';
import '../styles/home.css';
---
<BaseLayout title="Convera Strategies" description={site.description} canonical="/">
  <section class="home-hero">
    <div class="container home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow home-hero__descriptor">{site.descriptor}</p>
        <h1>People. Perspective.<br />A More Resilient Tomorrow.</h1>
        <p class="home-hero__text">
          Convera Strategies helps people and organizations navigate complex challenges, strengthen workplace culture, and protect the institutions that make a healthier, more hopeful future possible.
        </p>
        <div class="home-hero__actions">
          <a class="button button--primary" href="/mission/">Explore Our Mission <span aria-hidden="true">→</span></a>
          <a class="button button--ghost home-hero__support" href="/support/">Support the Work <span aria-hidden="true">→</span></a>
        </div>
        <p class="home-hero__signature">“A more thoughtful way forward.”</p>
      </div>
      <FounderPortrait />
    </div>
  </section>

  <section class="section--tight home-priority-row">
    <div class="container home-split">
      <article class="featured-publication">
        <div class="publication-art" aria-hidden="true"></div>
        <div>
          <p class="eyebrow">Featured Publication</p>
          <h2>{featuredPublication.title}</h2>
          <p class="muted">{featuredPublication.description}</p>
          <a class="text-link" href={publicationRecordHref(featuredPublication)}>View publication →</a>
        </div>
      </article>
      <SupportPanel />
    </div>
  </section>

  <section class="section inquiry-section">
    <div class="container">
      <div class="section-intro">
        <p class="eyebrow">Areas of Inquiry</p>
        <h2>Different questions. A shared purpose.</h2>
        <p class="lede">Convera moves between social perspective, workplace culture, and organizational strategy to understand problems in context and identify practical ways forward.</p>
      </div>
      <div class="inquiry-grid">
        {serviceAreas.map((area) => (
          <article class:list={['inquiry-card', `inquiry-card--${area.id}`]}>
            <div class="inquiry-card__wash" aria-hidden="true"></div>
            <div class="inquiry-card__content">
              <p class="eyebrow">{area.shortTitle}</p>
              <h3>{area.title}</h3>
              <p>{area.summary}</p>
              <a href={`/services/#${area.id}`}>Learn more →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight home-commercial">
    <div class="container">
      <CommercialCTA />
    </div>
  </section>

  <section class="section legacy-quote">
    <div class="container legacy-quote__inner">
      <span class="legacy-quote__mark" aria-hidden="true">“</span>
      <blockquote>{legacyQuote}</blockquote>
      <cite>Ryan Brown</cite>
    </div>
  </section>

  <section class="section--tight home-community">
    <div class="container community-row">
      <div>
        <p class="eyebrow">Join the Conversation</p>
        <h2>A thoughtful community for a stronger tomorrow.</h2>
      </div>
      <p class="lede">Share observations, recommend literature or records, suggest questions, and take part in conversations about people, culture, institutions, and what comes next.</p>
      <a class="button button--ghost" href="/community/">Visit Community →</a>
    </div>
  </section>

  <section class="section--tight home-support-band">
    <div class="container">
      <SupportPanel compact dark />
    </div>
  </section>
</BaseLayout>
