---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, founderQuote } from '../config/site';
import { featuredPublication, publicationRecordHref } from '../config/publications';
import { getCollection } from 'astro:content';
import '../styles/home.css';

const essays = await getCollection('blog', ({ data }) => data.status === 'published' && !data.draft && data.access === 'public');
const secondFeature = essays.find((entry) => entry.data.title.startsWith('Talk Is Cheap')) ?? essays.find((entry) => entry.data.featured) ?? essays[0];
const essayHref = secondFeature ? `/blog/${secondFeature.id.replace(/\.mdx?$/i, '')}/` : '/blog/';

const inquiryAreas = [
  { title: 'Social Perspectives', terms: 'Institutions · Policing · Courts · Public Life', href: '/services/#social-perspectives', icon: 'globe' },
  { title: 'Workplace Culture', terms: 'People · Communication · Trust', href: '/services/#workplace-culture', icon: 'people' },
  { title: 'Organizational Strategy', terms: 'Direction · Performance · Sustainable Growth', href: '/services/#organizational-strategy', icon: 'compass' }
] as const;
---
<BaseLayout title="Convera Strategies" description={site.description} canonical="/">
  <div class="convera-home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-shell home-hero__grid">
        <div class="home-hero__copy">
          <p class="home-tagline">{site.tagline}</p>
          <h1 id="home-title"><span>People. Perspective.</span><span>A More Resilient Tomorrow.</span></h1>
          <span class="home-rule" aria-hidden="true"></span>
          <p>
            Convera Strategies helps people and organizations navigate complex questions, strengthen workplace culture, and protect the institutions that make a healthier, more hopeful future possible.
          </p>
          <div class="home-hero__actions">
            <a class="home-button home-button--primary" href="/mission/">Explore Our Mission <span aria-hidden="true">→</span></a>
            <a class="home-button home-button--ghost" href="/support/">Support the Work <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="home-hero__portrait">
          <img src="/images/ryan-brown-hero.jpg" alt="Ryan Brown, founder of Convera Strategies" width="1535" height="1024" loading="eager" fetchpriority="high" />
        </div>

        <div class="home-hero__quote">
          <span class="home-quote-mark" aria-hidden="true">“</span>
          <blockquote>{founderQuote}</blockquote>
          <span class="home-rule home-rule--short" aria-hidden="true"></span>
          <p class="home-quote-name">Ryan Brown</p>
          <p class="home-quote-role">Founder, Convera Strategies</p>
        </div>
      </div>
    </section>

    <section class="home-feature-band" aria-label="Featured publication and support">
      <div class="home-shell home-feature-grid">
        <article class="home-featured-publication">
          <div class="home-kicker-row"><p class="home-kicker">Featured Publication</p><span aria-hidden="true"></span></div>
          <div class="home-publication-grid">
            <div class="home-publication-art">
              <img src={featuredPublication.image} alt={featuredPublication.imageAlt} width="1200" height="675" loading="lazy" />
            </div>
            <div class="home-publication-copy">
              <h2>{featuredPublication.title}</h2>
              <p>{featuredPublication.description}</p>
              <a href={publicationRecordHref(featuredPublication)}>Read the Publication <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </article>

        <aside class="home-support-card">
          <div class="home-support-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><circle cx="24" cy="15" r="6"></circle><circle cx="12" cy="20" r="4.5"></circle><circle cx="36" cy="20" r="4.5"></circle><path d="M14 38v-5c0-5 4-9 10-9s10 4 10 9v5M4 38v-4c0-4 3-7 8-7 2 0 4 .6 5.5 1.7M44 38v-4c0-4-3-7-8-7-2 0-4 .6-5.5 1.7"></path></svg>
          </div>
          <div>
            <h2>Make a Difference</h2>
            <p>Your support helps Convera pursue thoughtful work on people, organizations, institutions, and stronger communities.</p>
            <a class="home-button home-button--dark" href="/support/">Support the Work <span aria-hidden="true">→</span></a>
          </div>
        </aside>
      </div>
    </section>

    {secondFeature && (
      <section class="home-feature-band home-feature-band--secondary" aria-label="Featured essay and people in conversation">
        <div class="home-shell home-feature-grid">
          <article class="home-featured-publication">
            <div class="home-kicker-row"><p class="home-kicker">Featured Essay</p><span aria-hidden="true"></span></div>
            <div class="home-publication-grid">
              <div class="home-publication-art">
                <img src={secondFeature.data.image ?? '/images/blog/talk-is-cheap.jpg'} alt={secondFeature.data.imageAlt ?? 'Editorial image representing trust and connection'} width="1200" height="675" loading="lazy" style={`object-position:${secondFeature.data.imagePosition ?? 'center'}`} />
              </div>
              <div class="home-publication-copy">
                <h2>{secondFeature.data.title}</h2>
                <p>{secondFeature.data.description}</p>
                <a href={essayHref}>Read the Essay <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </article>
          <figure class="home-people-card">
            <img src="/images/editorial/people-connection.jpg" alt="People gathered for conversation in an institutional setting" width="1600" height="960" loading="lazy" />
            <figcaption><strong>People are what we do.</strong><span>Conversation · Connection · Public Life</span></figcaption>
          </figure>
        </div>
      </section>
    )}

    <section class="home-inquiry-band" aria-labelledby="inquiry-title">
      <div class="home-shell">
        <div class="home-section-title-row">
          <span aria-hidden="true"></span>
          <h2 id="inquiry-title">Areas of Inquiry</h2>
          <span aria-hidden="true"></span>
        </div>
        <div class="home-inquiry-grid">
          {inquiryAreas.map((area) => (
            <a class="home-inquiry-item" href={area.href}>
              <span class="home-inquiry-icon" aria-hidden="true">
                {area.icon === 'globe' && <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"></circle><path d="M7 24h34M24 7c5 5 8 10 8 17s-3 12-8 17M24 7c-5 5-8 10-8 17s3 12 8 17"></path></svg>}
                {area.icon === 'people' && <svg viewBox="0 0 48 48"><circle cx="24" cy="17" r="6"></circle><circle cx="11.5" cy="21" r="4"></circle><circle cx="36.5" cy="21" r="4"></circle><path d="M14 39v-5c0-5 4-9 10-9s10 4 10 9v5M4 39v-4c0-4 3-7 8-7 2 0 4 .6 5 1.6M44 39v-4c0-4-3-7-8-7-2 0-4 .6-5 1.6"></path></svg>}
                {area.icon === 'compass' && <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"></circle><path d="m29.5 18.5-4 9-9 4 4-9 9-4Z"></path><circle cx="24" cy="24" r="2"></circle></svg>}
              </span>
              <span>
                <strong>{area.title}</strong>
                <small>{area.terms}</small>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
