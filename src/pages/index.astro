---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, founderQuote } from '../config/site';
import { featuredPublication, publicationRecordHref } from '../config/publications';
import { getCollection } from 'astro:content';
import '../styles/home.css';

const essays = await getCollection('blog', ({ data }) => data.status === 'published' && !data.draft && data.access === 'public');
const secondFeature = essays.find((entry) => entry.data.title.startsWith('Talk Is Cheap')) ?? essays.find((entry) => entry.data.featured) ?? essays[0];
const essayHref = secondFeature ? `/blog/${secondFeature.id.replace(/\.mdx?$/i, '')}/` : '/blog/';

const inquiryAreas = [
  { title: 'Institutions & Public Life', terms: 'Authority · Trust · Public Responsibility', href: '/services/#social-perspectives', icon: 'globe' },
  { title: 'Group & Organizational Culture', terms: 'Relationships · Communication · Practice', href: '/services/#workplace-culture', icon: 'people' },
  { title: 'Records & Institutional Meaning', terms: 'Records · Narratives · Decisions', href: '/services/#organizational-strategy', icon: 'compass' }
] as const;

const serviceCards = [
  { title: 'Institutional Strategy', text: 'Clarify complex institutional problems and develop context-specific paths forward.', href: '/services/#organizational-strategy' },
  { title: 'Records & Institutional Analysis', text: 'Examine records, policies, decisions, and documented practices to identify consequential patterns.', href: '/services/' },
  { title: 'Culture & Organizational Change', text: 'Study relationships among stated values, everyday practices, group experiences, and institutional outcomes.', href: '/services/#workplace-culture' },
  { title: 'Narrative & Communication', text: 'Understand how language, interpretation, and public narratives influence trust and collective action.', href: '/services/' },
  { title: 'Speaking & Facilitation', text: 'Guide serious conversations about institutions, organizational culture, leadership, and social change.', href: '/speaking/' },
  { title: 'Support', text: 'Help sustain independent writing, publications, public-facing analysis, and resources serving a broader public purpose.', href: '/support/' }
] as const;
---
<BaseLayout title="Convera Strategies" description={site.description} canonical="/">
  <div class="convera-home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-shell home-hero__grid">
        <div class="home-hero__copy">
          <p class="home-hero__eyebrow">Institutional Strategy · Records Analysis · Organizational Culture</p>
          <h1 id="home-title"><span>Distinct approaches to complex institutional problems.</span></h1>
          <span class="home-rule" aria-hidden="true"></span>
          <p>
            Convera Strategies helps organizations examine complex problems, understand the conditions behind them, and develop responses suited to the groups and institutions involved.
          </p>
          <div class="home-hero__actions">
            <a class="home-button home-button--primary" href="/work-with-convera/">Work With Convera <span aria-hidden="true">→</span></a>
            <a class="home-button home-button--ghost" href="/about/#convera-approach">Explore Our Approach <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <figure class="home-hero__portrait">
          <div class="home-hero__portrait-media">
            <img src="/images/ryan-brown-hero.jpg" alt="Ryan Brown, founder of Convera Strategies" width="1535" height="1024" loading="eager" fetchpriority="high" />
          </div>
          <figcaption class="home-hero__identity">
            <div class="home-hero__identity-quote">
              <span class="home-quote-mark" aria-hidden="true">“</span>
              <blockquote>{founderQuote}</blockquote>
            </div>
            <div class="home-hero__identity-name">
              <p class="home-quote-name">{site.founder}, {site.founderCredential}</p>
              <p class="home-quote-role">Founder, Convera Strategies</p>
            </div>
            <p class="home-hero__roles">Researcher <span>·</span> Lecturer <span>·</span> Institutional Strategist</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="home-positioning" aria-labelledby="positioning-title">
      <div class="home-shell home-positioning__grid">
        <h2 id="positioning-title">People. Perspective. Possibility.</h2>
        <p>Institutional problems are shaped by history, organizational practice, group relationships, and the ways people interpret their circumstances. Understanding those conditions is the beginning of meaningful change.</p>
      </div>
    </section>

    <section class="home-inquiry-band" aria-labelledby="inquiry-title">
      <div class="home-shell">
        <div class="home-section-title-row"><span aria-hidden="true"></span><h2 id="inquiry-title">Areas of Inquiry</h2><span aria-hidden="true"></span></div>
        <div class="home-inquiry-grid">
          {inquiryAreas.map((area) => (
            <a class="home-inquiry-item" href={area.href}>
              <span class="home-inquiry-icon" aria-hidden="true">
                {area.icon === 'globe' && <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"></circle><path d="M7 24h34M24 7c5 5 8 10 8 17s-3 12-8 17M24 7c-5 5-8 10-8 17s3 12 8 17"></path></svg>}
                {area.icon === 'people' && <svg viewBox="0 0 48 48"><circle cx="24" cy="17" r="6"></circle><circle cx="11.5" cy="21" r="4"></circle><circle cx="36.5" cy="21" r="4"></circle><path d="M14 39v-5c0-5 4-9 10-9s10 4 10 9v5M4 39v-4c0-4 3-7 8-7 2 0 4 .6 5 1.6M44 39v-4c0-4-3-7-8-7-2 0-4 .6-5 1.6"></path></svg>}
                {area.icon === 'compass' && <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"></circle><path d="m29.5 18.5-4 9-9 4 4-9 9-4Z"></path><circle cx="24" cy="24" r="2"></circle></svg>}
              </span><span><strong>{area.title}</strong><small>{area.terms}</small></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-approach" id="convera-approach" aria-labelledby="approach-title">
      <div class="home-shell home-approach__grid">
        <div><p class="home-kicker">The Convera Approach</p><h2 id="approach-title">Similar problems may require different responses.</h2></div>
        <div class="home-approach__copy">
          <p>Problems carrying the same label may arise from different organizational conditions, institutional histories, group relationships, and operational practices. Convera Strategies begins by examining these differences rather than assuming a standard diagnosis or response will apply.</p>
          <p>Each engagement starts with systematic problem definition. Relevant records, administrative data, policies, documented practices, stakeholder accounts, and existing research are examined within their organizational and institutional contexts.</p>
          <p>Theoretical analysis helps identify the explanations and assumptions guiding current practice. Philosophical inquiry is used more narrowly to clarify questions of purpose, responsibility, value, and consequence when those questions affect how the problem is defined or addressed.</p>
          <p>This integrated approach supports responses shaped by the actual conditions of the problem rather than by category alone.</p>
          <a class="home-button home-button--dark" href="/about/#convera-approach">Explore the Convera Approach <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="home-services" aria-labelledby="services-title">
      <div class="home-shell">
        <div class="home-section-title-row"><span aria-hidden="true"></span><h2 id="services-title">How Convera Can Help</h2><span aria-hidden="true"></span></div>
        <div class="home-services__grid">
          {serviceCards.map((card, index) => <a class="home-service-card" href={card.href}><span>{String(index + 1).padStart(2, '0')}</span><h3>{card.title}</h3><p>{card.text}</p><strong>Explore <span aria-hidden="true">→</span></strong></a>)}
        </div>
      </div>
    </section>

    <section class="home-selected-work" aria-label="Selected work and support">
      <div class="home-shell home-feature-grid">
        <article class="home-featured-publication">
          <div class="home-kicker-row"><p class="home-kicker">Featured Publication</p><span aria-hidden="true"></span></div>
          <div class="home-publication-grid">
            <div class="home-publication-art">
              <img src="/images/home/an_objective_strategy.png" alt="Wooden judge’s gavel and sound block on a textured cream background" width="1536" height="1024" loading="lazy" />
            </div>
            <div class="home-publication-copy">
              <h2>{featuredPublication.title}</h2>
              <p>{featuredPublication.description}</p>
              <a href={publicationRecordHref(featuredPublication)}>Read the Publication <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </article>

        <aside class="home-side-card home-support-card">
          <div class="home-side-card__visual home-support-card__visual" aria-hidden="true">
            <div class="home-support-icon">
              <svg viewBox="0 0 48 48"><circle cx="24" cy="15" r="6"></circle><circle cx="12" cy="20" r="4.5"></circle><circle cx="36" cy="20" r="4.5"></circle><path d="M14 38v-5c0-5 4-9 10-9s10 4 10 9v5M4 38v-4c0-4 3-7 8-7 2 0 4 .6 5.5 1.7M44 38v-4c0-4-3-7-8-7-2 0-4 .6-5.5 1.7"></path></svg>
            </div>
          </div>
          <div class="home-side-card__copy">
            <p class="home-kicker">Support</p>
            <h2>Help the Work Travel Farther</h2>
            <p>Support gives Ryan Brown greater room to write, speak, and carry ideas about thoughtful institutional change into more organizations and public conversations.</p>
            <a class="home-button home-button--dark" href="/support/">Explore Support Options <span aria-hidden="true">→</span></a>
          </div>
        </aside>
      </div>
    </section>

    {secondFeature && (
      <section class="home-selected-work home-selected-work--secondary" aria-label="Featured essay and people in conversation">
        <div class="home-shell home-feature-grid">
          <article class="home-featured-publication">
            <div class="home-kicker-row"><p class="home-kicker">Featured Essay</p><span aria-hidden="true"></span></div>
            <div class="home-publication-grid">
              <div class="home-publication-art">
                <img src="/images/home/talk_is_cheap.png" alt="Speech bubble with a price tag changing from one dollar to one cent" width="1536" height="1024" loading="lazy" />
              </div>
              <div class="home-publication-copy">
                <h2>{secondFeature.data.title}</h2>
                <p>{secondFeature.data.description}</p>
                <a href={essayHref}>Read the Essay <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </article>
          <aside class="home-side-card home-connection-card">
            <div class="home-side-card__visual home-connection-card__media">
              <img src="/images/editorial/convera-people-network.svg" alt="Abstract illustration representing conversation, connection, and public life" width="1200" height="720" loading="lazy" />
            </div>
            <div class="home-side-card__copy home-connection-card__copy">
              <p class="home-kicker">Connection & Public Life</p>
              <h2>Conversation shapes what people notice, trust, and carry forward.</h2>
              <p>Shared experience can reveal what formal reports miss and where closer attention may be useful.</p>
              <a href="/community/">Explore Community <span aria-hidden="true">→</span></a>
            </div>
          </aside>
        </div>
      </section>
    )}

  </div>
</BaseLayout>
