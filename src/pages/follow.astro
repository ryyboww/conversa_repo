---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Follow the Work" description="Request occasional updates on new essays, publications, research, speaking, and Convera Strategies work." canonical="/follow/">
  <PageHero eyebrow="Follow the Work" title="Stay close to the ideas." lede="Request occasional updates when new essays, research, publications, speaking appearances, or substantive Convera work becomes public. This is intended as a low-frequency connection to the work—not a promotional email stream." />

  <section class="section">
    <div class="container follow-grid">
      <div>
        <p class="eyebrow">Updates</p>
        <h2>Choose what you want to hear about.</h2>
        <p class="lede">This form records your request. It does not silently add you to a third-party marketing platform.</p>
      </div>
      <form class="card follow-form" name="follow-the-work" method="POST" action="/follow/thank-you/" data-netlify="true" data-netlify-honeypot="bot-field" data-convera-attribution data-convera-event="follow_submit">
        <input type="hidden" name="form-name" value="follow-the-work" />
        <p class="honeypot" aria-hidden="true"><label>Leave this field blank <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <label>Email address<input name="email" type="email" autocomplete="email" required /></label>
        <label>First name <span class="muted">(optional)</span><input name="first_name" type="text" autocomplete="given-name" maxlength="80" /></label>
        <fieldset><legend>I am most interested in <span class="muted">(optional)</span></legend><label class="check"><input type="checkbox" name="interests" value="essays-publications" /> Essays and publications</label><label class="check"><input type="checkbox" name="interests" value="research" /> Research and public scholarship</label><label class="check"><input type="checkbox" name="interests" value="speaking" /> Speaking and public conversations</label><label class="check"><input type="checkbox" name="interests" value="convera" /> Convera Strategies updates</label></fieldset>
        <label class="check consent"><input type="checkbox" name="consent" value="yes" required /> <span>I am requesting occasional email updates from Convera Strategies. I understand I can withdraw this request later.</span></label>
        <button class="button button--primary" type="submit">Request Updates →</button>
        <p class="form-note">When an email provider is activated, required confirmation and unsubscribe controls will be configured before bulk sending.</p>
      </form>
    </div>
  </section>

  <section class="section--tight follow-alt"><div class="container follow-alt__inner"><div><p class="eyebrow">Prefer not to subscribe?</p><h2>You can still follow the public work.</h2><p>Browse Publications or follow Convera through its public social channels without joining an email list.</p></div><a class="button button--ghost" href="/publications/">Browse Publications →</a></div></section>

  <style>
    .follow-grid{display:grid;grid-template-columns:minmax(0,.75fr) minmax(380px,1.25fr);gap:clamp(2rem,5vw,5rem);align-items:start}.follow-grid h2{margin:.45rem 0 .8rem}
    .follow-form{position:relative;display:grid;gap:1rem;padding:clamp(1.4rem,3vw,2.2rem)}.follow-form label{display:grid;gap:.4rem;font-size:.9rem;font-weight:700}.follow-form input{width:100%;padding:.8rem .85rem;border:1px solid var(--line-strong);background:var(--surface);color:var(--text)}
    .honeypot{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}.follow-form fieldset{margin:0;padding:1rem;border:1px solid var(--line)}.follow-form legend{padding:0 .4rem;font-weight:700}.follow-form .check{grid-template-columns:auto 1fr;align-items:start;font-weight:500;color:var(--muted)}.follow-form .check input{width:auto;margin-top:.25rem}.follow-form fieldset .check+.check{margin-top:.55rem}.form-note{color:var(--muted);font-size:.76rem}
    .follow-alt{background:var(--surface-soft);border-top:1px solid var(--line)}.follow-alt__inner{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:center}.follow-alt h2{margin:.4rem 0 .6rem;font-size:clamp(1.8rem,2.8vw,2.5rem)}.follow-alt p:not(.eyebrow){color:var(--muted)}
    @media(max-width:820px){.follow-grid,.follow-alt__inner{grid-template-columns:1fr}.follow-alt__inner .button{width:fit-content}}@media(max-width:520px){.follow-grid{grid-template-columns:1fr}.follow-alt__inner .button{width:100%}}
  </style>
</BaseLayout>
