---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SupportPanel from '../../components/shared/SupportPanel.astro';
import { publications, publicationRecordHref } from '../../config/publications';
import { site } from '../../config/site';

export function getStaticPaths() {
  return publications.map((publication) => ({ params: { slug: publication.slug }, props: { publication } }));
}
const { publication } = Astro.props;
const recordUrl = new URL(publicationRecordHref(publication), site.url).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: publication.title,
  description: publication.description,
  datePublished: publication.date,
  author: publication.authors.map((name: string) => ({ '@type': 'Person', name })),
  publisher: { '@type': 'Organization', name: publication.publisher },
  mainEntityOfPage: recordUrl,
  url: recordUrl
};
---
<BaseLayout title={publication.title} description={publication.description} canonical={publicationRecordHref(publication)}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <header class="publication-record-hero">
    <div class="container publication-record-hero__inner">
      <p class="eyebrow">{publication.category}</p>
      <h1>{publication.title}</h1>
      <p class="lede">{publication.description}</p>
      <div class="record-meta">
        <span>{publication.publisher}</span>
        <span>{new Date(`${publication.date}T12:00:00`).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</span>
        <span>{publication.readMinutes} min read</span>
      </div>
      <a class="button button--primary" href={publication.href} target="_blank" rel="noopener">Read at Original Publisher ↗</a>
    </div>
  </header>

  <section class="section record-body">
    <div class="container record-grid">
      <article>
        <p class="eyebrow">Publication Record</p>
        <h2>About this work.</h2>
        <p>This publication is presented here as part of Convera Strategies’ public-facing archive. The complete work remains available through its original publisher.</p>
        <h3>Authors</h3>
        <p>{publication.authors.join(' · ')}</p>
        <h3>Why it belongs here</h3>
        <p>Convera’s work grows from sustained attention to institutions, organizational language, public authority, workplace culture, and the ways formal systems interpret contested problems. This publication reflects the institutional and legal dimension of that broader perspective.</p>
      </article>
      <aside class="record-aside card">
        <p class="eyebrow">Continue</p>
        <h3>Keep the work in conversation.</h3>
        <p class="muted">Explore additional publications, learn about Convera’s mission, or support the independent work developing around these questions.</p>
        <a class="text-link" href="/publications/">All Publications →</a>
        <a class="text-link" href="/mission/">Explore the Mission →</a>
        <a class="text-link" href="/support/">Support the Work →</a>
      </aside>
    </div>
  </section>
  <section class="section--tight record-support"><div class="container"><SupportPanel compact dark /></div></section>

  <style>
    .publication-record-hero{padding:clamp(4.5rem,8vw,8rem) 0;background:linear-gradient(120deg,#082b39,#124f5e 64%,#1b7180);color:#fff}
    .publication-record-hero .eyebrow{color:#7ce6f0}.publication-record-hero__inner{max-width:980px}.publication-record-hero h1{max-width:15ch}.publication-record-hero .lede{margin-top:1.3rem;color:rgba(255,255,255,.84);max-width:52rem}.record-meta{display:flex;flex-wrap:wrap;gap:.6rem 1.2rem;margin:1.4rem 0 1.7rem;color:rgba(255,255,255,.68);font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.record-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);gap:clamp(2rem,7vw,7rem);align-items:start}.record-body article{max-width:760px}.record-body h2{margin:.55rem 0 1rem}.record-body h3{margin:2rem 0 .65rem;font-size:1.75rem}.record-body article p{color:var(--muted);font-size:1.04rem}.record-aside{padding:1.6rem;display:grid;gap:.8rem;position:sticky;top:120px}.record-aside h3{margin:.2rem 0;font-size:2rem}.record-aside .text-link{margin-top:.2rem}.record-support{background:#082b39}@media(max-width:820px){.record-grid{grid-template-columns:1fr}.record-aside{position:static}}
  </style>
</BaseLayout>
