---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Page Not Found" description="The requested Convera Strategies page could not be found." canonical="/404/">
  <header class="page-hero">
    <div class="container page-hero__inner">
      <p class="eyebrow">404</p>
      <h1>This page has not found its way forward.</h1>
      <p class="lede">The address may have changed, or the page may not be available yet.</p>
      <div style="display:flex;gap:.8rem;flex-wrap:wrap;margin-top:.8rem">
        <a class="button button--primary" href="/">Return Home →</a>
        <a class="button button--ghost" href="/contact/">Contact Convera →</a>
      </div>
    </div>
  </header>
</BaseLayout>
