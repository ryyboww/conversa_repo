---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Thank You for Supporting Convera" description="Thank you for supporting Convera Strategies." canonical="/support/thank-you/">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <p class="eyebrow">Thank You</p>
      <h1>Your support helps make the work possible.</h1>
      <p class="lede">Contributions help sustain Convera’s publications, community-facing work, platform infrastructure, and continued development of a different way of approaching complex problems.</p>
      <div class="thanks-actions">
        <a class="button button--primary" href="/mission/">Explore the Mission →</a>
        <a class="button button--ghost" href="/publications/">Read Publications →</a>
      </div>
    </div>
  </section>
  <style>.thanks-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1rem}@media(max-width:520px){.thanks-actions{display:grid}.thanks-actions .button{width:100%}}</style>
</BaseLayout>
