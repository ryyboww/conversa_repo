---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = site.name,
  description = site.description,
  canonical = Astro.url.pathname,
  image = '/og/convera-social-card.jpg',
  noindex = false
} = Astro.props;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = new URL(canonical, site.url).toString();
const imageUrl = new URL(image, site.url).toString();
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN?.trim();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      name: site.name,
      url: site.url,
      description: site.description,
      slogan: site.tagline,
      email: site.emails.public,
      logo: new URL('/brand/convera-logo-light-bg.png', site.url).toString(),
      founder: { '@id': `${site.url}/#founder` },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'customer support',
          email: site.emails.help,
          url: new URL('/contact/', site.url).toString()
        },
        {
          '@type': 'ContactPoint',
          contactType: 'professional inquiries',
          email: site.emails.founder,
          url: new URL('/contact/', site.url).toString()
        }
      ],
      sameAs: [site.social.linkedin, site.social.instagram]
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#founder`,
      name: site.founder,
      honorificSuffix: site.founderCredential,
      jobTitle: [site.founderTitle, ...site.founderRoles],
      email: site.emails.founder,
      image: new URL('/images/ryan-brown-press.jpg', site.url).toString(),
      worksFor: { '@id': `${site.url}/#organization` },
      sameAs: [site.social.linkedin, site.social.instagram, 'https://ryanbrownonline.com']
    }
  ]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f2ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#081f2b" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Convera Strategies Publications & Essays" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Convera Strategies — People. Perspective. A More Resilient Tomorrow." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Convera Strategies — People. Perspective. A More Resilient Tomorrow." />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    {plausibleDomain && <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('convera-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
            return;
          }
          const prefersDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches ?? false;
          document.documentElement.dataset.theme = prefersDark ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content"><slot /></main>
    <SiteFooter />
    <script is:inline src="/assets/convera-attribution.js" defer></script>
    <script is:inline src="/assets/convera-growth.js" defer></script>
    <script is:inline src="/assets/convera-motion.js" defer></script>
  </body>
</html>
