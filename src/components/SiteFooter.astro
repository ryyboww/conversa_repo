---
import { site } from '../config/site';
import { features } from '../config/features';
import NewsletterSignup from './shared/NewsletterSignup.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  {features.newsletter && <div class="footer-newsletter"><NewsletterSignup compact /></div>}
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" aria-label="Convera Strategies home">
        <img src="/brand/convera-logo-inverse.png" alt="Convera Strategies" width="562" height="134" loading="lazy" decoding="async" />
      </a>
      <p>{site.descriptor}</p>
    </div>

    <div class="footer-meta">
      <div class="footer-social" aria-label="Social links">
        <a href={site.social.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
        <a href={site.social.instagram} rel="me noopener" target="_blank">Instagram</a>
      </div>
      <div class="footer-legal" aria-label="Legal links">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/accessibility/">Accessibility</a>
      </div>
      <p class="footer-copyright">© {year} Convera Strategies. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 22px 0 20px;
    color: #eef7f8;
    background: #052a38;
    border-top: 1px solid rgba(255,255,255,0.11);
  }
  .footer-newsletter {
    width: min(calc(100% - 48px), 1280px);
    margin: 0 auto 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255,255,255,.11);
  }
  .footer-inner {
    width: min(calc(100% - 48px), 1280px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 42px;
  }
  .footer-brand { min-width: 0; }
  .footer-brand a {
    display: inline-flex;
    align-items: center;
    width: 168px;
    max-width: 100%;
    text-decoration: none;
  }
  .footer-brand img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .footer-brand p {
    margin: 7px 0 0;
    color: rgba(238,247,248,.78);
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(8px, .72vw, 10.5px);
    line-height: 1.1;
    white-space: nowrap;
  }
  .footer-meta {
    display: grid;
    justify-items: end;
    gap: 8px;
    text-align: right;
  }
  .footer-social,
  .footer-legal {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
  }
  .footer-social a,
  .footer-legal a {
    color: rgba(238,247,248,.9);
    text-decoration: none;
    font-size: 0.75rem;
  }
  .footer-legal a { color: rgba(238,247,248,.64); font-size: .7rem; }
  .footer-social a:hover,
  .footer-legal a:hover { color: #76d9e3; }
  .footer-copyright {
    margin: 0;
    color: rgba(238,247,248,.58);
    font-size: .7rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .footer-inner,
    .footer-newsletter { width: min(calc(100% - 30px), 1280px); }
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 16px;
      align-items: start;
    }
    .footer-brand a { width: 150px; }
    .footer-brand p { font-size: clamp(7.2px, 2.05vw, 9.2px); }
    .footer-meta { justify-items: start; text-align: left; gap: 7px; }
    .footer-social,
    .footer-legal { justify-content: flex-start; flex-wrap: wrap; }
    .footer-copyright { white-space: normal; }
  }
</style>
