---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  tagline?: string;
  tone?: 'light' | 'dark';
  compact?: boolean;
  dense?: boolean;
}

const {
  eyebrow,
  title,
  lede,
  tagline,
  tone = 'light',
  compact = false,
  dense = false
} = Astro.props;

const hasAside = Astro.slots.has('aside');
const hasActions = Astro.slots.has('actions');
const hasMeta = Astro.slots.has('meta');
---
<header class:list={[
  'page-hero',
  tone === 'dark' && 'page-hero--dark',
  compact && 'page-hero--compact',
  dense && 'page-hero--dense',
  hasAside && 'page-hero--split'
]}>
  <div class:list={['container', 'page-hero__layout', hasAside && 'page-hero__layout--split']}>
    <div class="page-hero__inner">
      <p class="eyebrow">{eyebrow}</p>
      {tagline && <p class="page-hero__tagline">{tagline}</p>}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      {hasMeta && <div class="page-hero__meta"><slot name="meta" /></div>}
      {hasActions && <div class="page-hero__actions"><slot name="actions" /></div>}
    </div>
    {hasAside && <div class="page-hero__aside"><slot name="aside" /></div>}
  </div>
</header>
