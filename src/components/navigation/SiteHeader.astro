---
/**
 * Convera Strategies 2.33.0 — stable publication header.
 * No scroll-state transformations are used; the logo remains visible and fixed.
 */
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Mission', href: '/mission/' },
  { label: 'Services', href: '/services/' },
  { label: 'Publications', href: '/publications/' },
  { label: 'Community', href: '/community/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const searchItems = [
  ...navItems,
  { label: 'Speaking & Media', href: '/speaking/' },
  { label: 'Follow the Work', href: '/follow/' },
  { label: 'Support', href: '/support/' },
];

const normalize = (value: string) =>
  value === '/' ? '/' : value.endsWith('/') ? value : `${value}/`;
const activePath = normalize(currentPath);
const isActive = (href: string) => {
  const normalized = normalize(href);
  return normalized === '/' ? activePath === '/' : activePath.startsWith(normalized);
};
---

<header class="cv-site-header">
  <div class="cv-site-header__inner">
    <a class="cv-site-header__brand" href="/" aria-label="Convera Strategies home">
      <img
        class="cv-site-header__logo cv-site-header__logo--light"
        src="/images/convera-logo-header.png"
        width="562"
        height="134"
        alt="Convera Strategies"
        loading="eager"
        decoding="async"
      />
      <img
        class="cv-site-header__logo cv-site-header__logo--dark"
        src="/images/convera-logo-footer.png"
        width="562"
        height="134"
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="cv-site-header__nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="cv-site-header__utilities">
      <button
        class="cv-icon-button"
        type="button"
        data-cv-theme-toggle
        aria-label="Toggle light and dark theme"
      >
        <svg class="cv-icon cv-icon--moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20.2 15.1A8.2 8.2 0 0 1 8.9 3.8 8.4 8.4 0 1 0 20.2 15.1Z"></path>
        </svg>
      </button>
      <span class="cv-site-header__divider" aria-hidden="true"></span>
      <button
        class="cv-icon-button"
        type="button"
        data-cv-search-toggle
        aria-controls="cv-site-search"
        aria-expanded="false"
        aria-label="Search this site"
      >
        <svg class="cv-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="6.7"></circle>
          <path d="m16 16 4.3 4.3"></path>
        </svg>
      </button>

      <details class="cv-mobile-menu">
        <summary aria-label="Open navigation menu">
          <span></span><span></span><span></span>
        </summary>
        <nav aria-label="Mobile navigation">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a href="/support/">Support</a>
        </nav>
      </details>
    </div>
  </div>

  <div class="cv-site-search" id="cv-site-search" hidden data-cv-search-panel>
    <div class="cv-site-search__inner">
      <label for="cv-site-search-input">Search Convera Strategies</label>
      <div class="cv-site-search__field-row">
        <input id="cv-site-search-input" type="search" autocomplete="off" placeholder="Type to filter pages…" data-cv-search-input />
        <button class="cv-search-close" type="button" data-cv-search-close aria-label="Close search">Close</button>
      </div>
      <ul data-cv-search-results>
        {searchItems.map((item) => (
          <li data-search-label={item.label.toLowerCase()}><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script is:inline>
(() => {
  const root = document.documentElement;
  const themeButton = document.querySelector('[data-cv-theme-toggle]');
  const searchButton = document.querySelector('[data-cv-search-toggle]');
  const searchPanel = document.querySelector('[data-cv-search-panel]');
  const searchClose = document.querySelector('[data-cv-search-close]');
  const searchInput = document.querySelector('[data-cv-search-input]');
  const searchRows = Array.from(document.querySelectorAll('[data-search-label]'));

  themeButton?.addEventListener('click', () => {
    const current = root.dataset.theme || localStorage.getItem('convera-theme') || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('convera-theme', next);
  });

  const openSearch = () => {
    if (!searchPanel || !searchButton) return;
    searchPanel.hidden = false;
    searchButton.setAttribute('aria-expanded', 'true');
    requestAnimationFrame(() => searchInput?.focus());
  };

  const closeSearch = () => {
    if (!searchPanel || !searchButton) return;
    searchPanel.hidden = true;
    searchButton.setAttribute('aria-expanded', 'false');
    searchButton.focus();
  };

  searchButton?.addEventListener('click', () => searchPanel?.hidden ? openSearch() : closeSearch());
  searchClose?.addEventListener('click', closeSearch);
  searchInput?.addEventListener('input', (event) => {
    const query = event.currentTarget.value.trim().toLowerCase();
    searchRows.forEach((row) => {
      row.hidden = Boolean(query) && !row.dataset.searchLabel.includes(query);
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && searchPanel && !searchPanel.hidden) closeSearch();
  });
})();
</script>

<style>
  .cv-site-header {
    position: sticky !important;
    top: 0 !important;
    z-index: 9999 !important;
    width: 100%;
    isolation: isolate;
    background: rgba(244, 242, 236, 0.995);
    border-bottom: 1px solid rgba(7, 45, 62, 0.16);
    color: #082f43;
    box-shadow: 0 2px 10px rgba(5, 34, 46, 0.045);
    backdrop-filter: saturate(125%) blur(10px);
    -webkit-backdrop-filter: saturate(125%) blur(10px);
  }

  .cv-site-header__inner {
    width: min(calc(100% - 64px), 1320px);
    min-height: 88px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(240px, 0.9fr) auto auto;
    align-items: center;
    gap: clamp(22px, 2.3vw, 38px);
    padding: 9px 0 15px;
  }

  .cv-site-header__brand {
    position: relative;
    z-index: 2;
    display: inline-flex !important;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    min-height: 58px;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    text-decoration: none;
    line-height: 0;
  }

  .cv-site-header__logo {
    display: block !important;
    width: clamp(220px, 19vw, 268px) !important;
    height: auto !important;
    max-width: 100% !important;
    max-height: none !important;
    object-fit: contain;
    object-position: left center;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    flex: 0 0 auto;
  }

  .cv-site-header__logo--dark { display: none !important; }

  .cv-site-header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 1.7vw, 27px);
    min-width: 0;
  }

  .cv-site-header__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #092f43;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .cv-site-header__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 2px;
    background: #0b879c;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 150ms ease;
  }

  .cv-site-header__nav a:hover::after,
  .cv-site-header__nav a[aria-current="page"]::after { transform: scaleX(1); }

  .cv-site-header__utilities {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }

  .cv-icon-button {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #092f43;
    background: transparent;
    cursor: pointer;
  }

  .cv-icon-button:hover { background: rgba(11, 135, 156, 0.08); }

  .cv-icon-button:focus-visible,
  .cv-site-header a:focus-visible,
  .cv-mobile-menu summary:focus-visible {
    outline: 3px solid #2eb8c8;
    outline-offset: 3px;
  }

  .cv-icon {
    width: 21px;
    height: 21px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cv-icon--moon { fill: currentColor; stroke-width: 1.2; }

  .cv-site-header__divider {
    width: 1px;
    height: 27px;
    background: rgba(10, 57, 73, 0.28);
  }

  .cv-mobile-menu { display: none; position: relative; }
  .cv-mobile-menu summary {
    list-style: none;
    width: 38px;
    height: 38px;
    display: grid;
    align-content: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
  }
  .cv-mobile-menu summary::-webkit-details-marker { display: none; }
  .cv-mobile-menu summary span { width: 23px; height: 2px; background: currentColor; }

  .cv-mobile-menu nav {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    min-width: 230px;
    padding: 11px;
    border: 1px solid rgba(12, 70, 86, 0.14);
    border-radius: 4px;
    background: #fbfaf7;
    box-shadow: 0 18px 42px rgba(4, 33, 43, 0.16);
  }
  .cv-mobile-menu nav a {
    display: block;
    padding: 9px 11px;
    color: #14384c;
    text-decoration: none;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
  }

  .cv-site-search {
    border-top: 1px solid rgba(13, 66, 84, 0.10);
    background: #fbfaf7;
  }
  .cv-site-search[hidden] { display: none; }
  .cv-site-search__inner {
    width: min(calc(100% - 64px), 960px);
    margin-inline: auto;
    padding: 16px 0 20px;
  }
  .cv-site-search label {
    display: block;
    margin-bottom: 7px;
    color: #355a68;
    font: 700 10px/1.2 "Inter", Arial, sans-serif;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .cv-site-search__field-row { display: grid; grid-template-columns: 1fr auto; gap: 10px; }
  .cv-site-search input {
    width: 100%;
    min-height: 42px;
    padding: 9px 12px;
    border: 1px solid #8aaab3;
    border-radius: 3px;
    color: #11394d;
    background: #fff;
    font-size: 16px;
  }
  .cv-search-close {
    padding: 8px 13px;
    border: 1px solid #8aaab3;
    border-radius: 3px;
    color: #11394d;
    background: transparent;
    cursor: pointer;
  }
  .cv-site-search ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .cv-site-search a { color: #0b6077; text-decoration: none; }

  :global(html[data-theme="dark"]) .cv-site-header {
    color: #eaf5f6;
    background: rgba(6, 36, 48, 0.99);
    border-bottom-color: rgba(119, 204, 215, 0.18);
  }
  :global(html[data-theme="dark"]) .cv-site-header__logo--light { display: none !important; }
  :global(html[data-theme="dark"]) .cv-site-header__logo--dark { display: block !important; }
  :global(html[data-theme="dark"]) .cv-site-header__nav a,
  :global(html[data-theme="dark"]) .cv-icon-button,
  :global(html[data-theme="dark"]) .cv-mobile-menu nav a { color: #eef7f8; }
  :global(html[data-theme="dark"]) .cv-mobile-menu nav,
  :global(html[data-theme="dark"]) .cv-site-search { background: #0c303d; }

  @media (max-width: 1120px) {
    .cv-site-header__inner {
      width: min(calc(100% - 40px), 1320px);
      grid-template-columns: minmax(220px, 1fr) auto;
      min-height: 80px;
      padding-bottom: 13px;
    }
    .cv-site-header__nav { display: none; }
    .cv-mobile-menu { display: block; }
    .cv-site-header__logo { width: clamp(210px, 27vw, 250px) !important; }
  }

  @media (max-width: 560px) {
    .cv-site-header__inner {
      width: calc(100% - 26px);
      min-height: 72px;
      gap: 10px;
      padding: 8px 0 11px;
    }
    .cv-site-header__logo { width: min(205px, 51vw) !important; }
    .cv-site-header__divider { display: none; }
    .cv-icon-button { width: 33px; height: 33px; }
    .cv-site-search__inner { width: calc(100% - 30px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-site-header__nav a::after { transition: none; }
  }
</style>
