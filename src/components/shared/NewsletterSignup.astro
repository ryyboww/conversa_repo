---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<form
  class:list={['newsletter-signup', compact && 'newsletter-signup--compact']}
  name="convera-newsletter"
  method="POST" accept-charset="UTF-8"
  action="/thank-you/?from=newsletter"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
>
  <input type="hidden" name="form-name" value="convera-newsletter" />
  <p class="newsletter-honeypot" aria-hidden="true">
    <label>Leave this field blank <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>
  <div>
    <p class="eyebrow">Stay Informed</p>
    <strong>New publications, community notes, and Convera updates.</strong>
  </div>
  <label class="newsletter-field">
    <span class="sr-only">Email address</span>
    <input required type="email" name="email" autocomplete="email" maxlength="254" placeholder="Email address" />
  </label>
  <button class="button button--primary" type="submit">Subscribe →</button>
</form>

<style>
  .newsletter-signup{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,.65fr) auto;gap:1rem;align-items:end;padding:1.3rem 0}.newsletter-signup strong{display:block;margin-top:.35rem;font-family:"Cormorant Garamond",Georgia,serif;font-size:1.45rem;font-weight:500;line-height:1.1}.newsletter-field{display:grid}.newsletter-field input{min-height:48px;width:100%;padding:.7rem .85rem;border:1px solid var(--line-strong);background:var(--surface);color:var(--text);border-radius:3px}.newsletter-honeypot{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}.newsletter-signup--compact{grid-template-columns:minmax(0,1fr) minmax(200px,.7fr) auto}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:780px){.newsletter-signup,.newsletter-signup--compact{grid-template-columns:1fr}.newsletter-signup .button{width:fit-content}}@media(max-width:520px){.newsletter-signup .button{width:100%}}
</style>
