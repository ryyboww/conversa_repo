---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<section class:list={['commercial-cta', compact && 'commercial-cta--compact']}>
  <div class="commercial-cta__copy">
    <p class="eyebrow">Work With Convera</p>
    <h2>{compact ? 'Need a clearer view of the problem?' : 'Focused support for challenges that deserve a closer look.'}</h2>
    <p>
      Convera offers founder-led engagements for organizational strategy, workplace culture, and challenges that benefit from broader social and institutional context.
    </p>
  </div>
  <div class="commercial-cta__actions">
    <a class="button button--primary" href="/contact/?reason=professional">Contact Convera →</a>
    <a class="button button--ghost" href="/services/">Explore Services →</a>
  </div>
</section>

<style>
  .commercial-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1.7rem, 3.2vw, 2.6rem);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
  }
  .commercial-cta__copy { max-width: 770px; }
  .commercial-cta h2 { margin: .5rem 0 .8rem; font-size: clamp(2rem, 3.4vw, 3rem); }
  .commercial-cta p:not(.eyebrow) { color: var(--muted); }
  .commercial-cta__actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .75rem; }
  .commercial-cta--compact h2 { font-size: clamp(1.8rem, 2.8vw, 2.45rem); }
  @media (max-width: 820px) {
    .commercial-cta { grid-template-columns: 1fr; }
    .commercial-cta__actions { justify-content: flex-start; }
  }
  @media (max-width: 520px) {
    .commercial-cta__actions { display: grid; }
    .commercial-cta__actions .button { width: 100%; }
  }
</style>
