---
import { site, founderQuote } from '../../config/site';
---
<div class="founder-portrait">
  <div class="founder-portrait__image">
    <img src="/images/ryan-brown.jpg" alt="Ryan Brown, founder of Convera Strategies" width="1400" height="696" loading="eager" fetchpriority="high" />
  </div>
  <blockquote class="founder-portrait__quote">
    “{founderQuote}”
    <cite>{site.founder} · {site.founderTitle}</cite>
  </blockquote>
</div>
<style>
  .founder-portrait{position:relative;min-width:0;align-self:end;padding-bottom:2rem}.founder-portrait__image{position:relative;overflow:hidden;aspect-ratio:1.7/1;background:#123746;box-shadow:0 30px 80px rgba(0,0,0,.28)}.founder-portrait__image::before{content:'';position:absolute;inset:.75rem -.75rem -.75rem .75rem;border:1px solid rgba(113,221,231,.35);z-index:-1}.founder-portrait__image img{width:100%;height:100%;object-fit:cover;object-position:center center;filter:saturate(.94) contrast(1.02)}.founder-portrait__quote{position:absolute;z-index:3;right:-.5rem;bottom:0;width:min(355px,82%);margin:0;padding:1.15rem 1.3rem;color:#fff;background:rgba(4,27,38,.88);border-left:2px solid #72deea;backdrop-filter:blur(14px);font-size:clamp(1.2rem,1.7vw,1.58rem);line-height:1.08}.founder-portrait__quote cite{display:block;margin-top:.75rem;color:#82dce6;font-family:Inter,sans-serif;font-size:.65rem;font-style:normal;font-weight:700;letter-spacing:.16em;text-transform:uppercase}@media(max-width:900px){.founder-portrait{width:min(100%,760px);margin-inline:auto}.founder-portrait__quote{right:0}}@media(max-width:520px){.founder-portrait{padding-bottom:0}.founder-portrait__image{aspect-ratio:1.35/1}.founder-portrait__quote{position:relative;right:auto;bottom:auto;width:100%;margin-top:.8rem}}
</style>
