---
/** Convera Strategies 2.33.0 — simplified publication footer. */
const year = new Date().getFullYear();
---

<footer class="cv-footer">
  <div class="cv-footer__inner">
    <section class="cv-footer__brand" aria-label="Convera Strategies">
      <a class="cv-footer__brand-link" href="/" aria-label="Convera Strategies home">
        <img
          src="/images/convera-logo-footer.png"
          width="562"
          height="134"
          alt="Convera Strategies"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="cv-footer__descriptor">Social Perspectives · Workplace Culture · Organizational Strategy</p>
    </section>

    <section class="cv-footer__meta" aria-label="Convera social links and copyright">
      <div class="cv-footer__social">
        <a href="https://www.linkedin.com/in/ryan-brown-7b153621" aria-label="LinkedIn" rel="noopener noreferrer" target="_blank">in</a>
        <a href="https://www.instagram.com/ryyboww" aria-label="Instagram" rel="noopener noreferrer" target="_blank">◎</a>
        <a href="https://x.com/ryyboww" aria-label="X" rel="noopener noreferrer" target="_blank">𝕏</a>
      </div>
      <p>© {year} Convera Strategies. All rights reserved.</p>
    </section>
  </div>
</footer>

<style>
  .cv-footer {
    color: #eef7f8;
    background: #052a38;
    border-top: 1px solid rgba(121, 194, 207, 0.12);
  }

  .cv-footer__inner {
    width: min(calc(100% - 64px), 1320px);
    min-height: 126px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 44px;
    padding: 20px 0 22px;
  }

  .cv-footer__brand {
    min-width: 0;
  }

  .cv-footer__brand-link {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    line-height: 0;
    text-decoration: none;
  }

  .cv-footer__brand-link img {
    display: block;
    width: 202px;
    height: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .cv-footer__descriptor {
    margin: 8px 0 0;
    max-width: 100%;
    white-space: nowrap;
    overflow: visible;
    color: rgba(240, 248, 249, 0.92);
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(8px, 0.74vw, 11px);
    line-height: 1.1;
    letter-spacing: -0.006em;
  }

  .cv-footer__meta {
    display: grid;
    justify-items: end;
    gap: 12px;
    text-align: right;
  }

  .cv-footer__social {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cv-footer__social a {
    display: inline-grid;
    place-items: center;
    min-width: 24px;
    min-height: 24px;
    color: #fff;
    font: 700 18px/1 "Inter", Arial, sans-serif;
    text-decoration: none;
  }

  .cv-footer__meta p {
    margin: 0;
    color: rgba(238, 247, 248, 0.76);
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 11px;
    line-height: 1.2;
    white-space: nowrap;
  }

  .cv-footer a:focus-visible {
    outline: 3px solid #4fd0dc;
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .cv-footer__inner {
      width: min(calc(100% - 36px), 1320px);
      grid-template-columns: 1fr;
      gap: 17px;
      min-height: 0;
      padding: 20px 0;
    }
    .cv-footer__brand-link img { width: 176px; }
    .cv-footer__descriptor {
      font-size: clamp(7.2px, 2.25vw, 9.5px);
      white-space: nowrap;
    }
    .cv-footer__meta {
      justify-items: start;
      text-align: left;
      gap: 9px;
    }
    .cv-footer__meta p { white-space: normal; }
  }
</style>
