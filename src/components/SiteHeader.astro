---
import ThemeToggle from './ThemeToggle.astro';
import { navigation } from '../config/navigation';
import { site } from '../config/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header class="site-header">
  <div class="header-inner">
    <a class="site-brand" href="/" aria-label={`${site.name} home`}>
      <img class="site-brand__light" src="/brand/convera-logo-header.png" alt="Convera Strategies" width="1038" height="250" />
      <img class="site-brand__dark" src="/brand/convera-logo-inverse.png" alt="Convera Strategies" width="562" height="134" />
      <span class="site-brand__tagline">{site.tagline}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a class:list={[isActive(item.href) && 'is-active']} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-tools">
      <ThemeToggle />
      <details class="mobile-menu">
        <summary aria-label="Navigation menu"><span></span><span></span><span></span></summary>
        <nav aria-label="Mobile navigation">
          {navigation.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    color: #0a3448;
    background: rgba(241, 238, 230, 0.985);
    border-bottom: 1px solid rgba(10, 52, 72, 0.15);
    box-shadow: 0 2px 9px rgba(7, 38, 52, 0.035);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-inner {
    width: min(calc(100% - var(--page-gutter) - var(--page-gutter)), 1280px);
    min-height: 96px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(180px, clamp(190px, 18vw, 270px)) minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(10px, 2vw, 34px);
    padding: 10px 0 15px;
  }

  .site-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: min(100%, clamp(190px, 18vw, 270px));
    min-width: 0;
    text-decoration: none;
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .site-brand img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
    opacity: 1;
    visibility: visible;
    transform: none;
  }


  .site-brand__tagline {
    display: block;
    width: 64%;
    margin-top: 2px;
    margin-left: 34.5%;
    color: #214f61;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(.70rem, .72vw, .80rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1;
    letter-spacing: .015em;
    text-align: center;
    white-space: nowrap;
  }
  .site-brand__dark { display: none !important; }
  :global(:root[data-theme='dark']) .site-brand__light { display: none !important; }
  :global(:root[data-theme='dark']) .site-brand__dark { display: block !important; }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(8px, 1.25vw, 22px);
    min-width: 0;
  }

  .desktop-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #0a3448;
    text-decoration: none;
    font-size: clamp(.78rem, .86vw, .9rem);
    font-weight: 600;
    white-space: nowrap;
  }

  .desktop-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 5px;
    height: 2px;
    background: #14798c;
    transition: right 150ms ease;
  }
  .desktop-nav a:hover::after,
  .desktop-nav a.is-active::after { right: 0; }

  .header-tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 38px;
  }

  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary {
    list-style: none;
    width: 38px;
    height: 38px;
    padding: 9px 7px;
    display: grid;
    align-content: center;
    gap: 4px;
    cursor: pointer;
    border-radius: 50%;
  }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary span {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
  }
  .mobile-menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    width: min(82vw, 300px);
    padding: 10px;
    display: grid;
    gap: 2px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .mobile-menu nav a {
    min-height: 44px;
    padding: 11px 12px;
    display: flex;
    align-items: center;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile-menu nav a:last-child { border-bottom: 0; }
  .mobile-menu nav a[aria-current='page'] { color: var(--accent); font-weight: 700; }

  :global(:root[data-theme='dark']) .site-header {
    color: #eef7f8;
    background: rgba(6, 31, 43, 0.985);
    border-bottom-color: rgba(206, 237, 241, 0.13);
  }
  :global(:root[data-theme='dark']) .desktop-nav a { color: #eef7f8; }
  :global(:root[data-theme='dark']) .site-brand__tagline { color: #d8eef1; }

  @media (min-width: 821px) and (max-width: 1080px) {
    .header-inner {
      min-height: 88px;
      grid-template-columns: minmax(170px, clamp(176px, 18vw, 210px)) minmax(0, 1fr) auto;
      gap: clamp(8px, 1.25vw, 16px);
      padding: 9px 0 13px;
    }
    .site-brand { width: min(100%, clamp(176px, 18vw, 210px)); }
    .site-brand__tagline { font-size: clamp(.64rem, .69vw, .72rem); }
    .desktop-nav { gap: clamp(6px, .9vw, 12px); }
    .desktop-nav a { font-size: clamp(.7rem, .76vw, .78rem); }
  }

  @media (max-width: 820px) {
    .header-inner { grid-template-columns: minmax(220px, 1fr) auto; }
    .desktop-nav { display: none; }
    .header-tools { gap: 5px; }
    .mobile-menu { display: block; }
  }

  @media (max-width: 560px) {
    .header-inner {
      width: min(calc(100% - 28px), 1280px);
      min-height: 84px;
      padding: 8px 0 12px;
    }
    .site-brand { width: min(100%, 220px); }
    .site-brand__tagline { width: 64%; margin-left: 34.5%; font-size: .69rem; }
  }
</style>

<script is:inline>
  (() => {
    const menu = document.querySelector('.mobile-menu');
    if (!(menu instanceof HTMLDetailsElement)) return;
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => { menu.open = false; });
    });
  })();
</script>
