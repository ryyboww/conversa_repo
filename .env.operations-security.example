# Convera Strategies — private operations and portal-security configuration
# Copy required values into Netlify or a local private environment file.
# Never commit real keys, tokens, passwords, or provider credentials.

# Operator access
CONVERA_OPERATOR_KEY=
CONVERA_OPERATOR_NOTIFICATION_EMAIL=

# Signed client links and portal verification
CONVERA_ENGAGEMENT_TOKEN_SECRET=
CONVERA_PORTAL_OTP_SECRET=
CONVERA_PORTAL_REQUIRE_EMAIL_VERIFICATION=true
CONVERA_PORTAL_OTP_TTL_MINUTES=10
CONVERA_PORTAL_OTP_COOLDOWN_SECONDS=60
CONVERA_PORTAL_MAX_ATTEMPTS=5
CONVERA_PORTAL_SESSION_HOURS=8
CONVERA_PORTAL_DEFAULT_DAYS=30

# Public/canonical site addresses
PUBLIC_SITE_URL=https://converastrategies.com
CONVERA_SITE_URL=https://converastrategies.com

# Transactional email provider
RESEND_API_KEY=
CONVERA_FROM_EMAIL=
CONVERA_PORTAL_FROM_EMAIL=
CONVERA_PORTAL_REPLY_TO=
CONVERA_ESTIMATE_FROM_EMAIL=
CONVERA_ESTIMATE_REPLY_TO=
CONVERA_AGREEMENT_FROM_EMAIL=
CONVERA_AGREEMENT_REPLY_TO=
CONVERA_REMINDER_FROM_EMAIL=
CONVERA_REMINDER_REPLY_TO=

# Optional review-page overrides
CONVERA_AGREEMENT_REVIEW_URL=
CONVERA_CHANGE_ORDER_REVIEW_URL=

# Optional planning capacity used by Operations Intelligence
CONVERA_CAPACITY_UNITS=
