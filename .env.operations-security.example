# Convera Strategies 2.28 — Operations Intelligence & Portal Security

# Existing secrets retained from prior releases
CONVERA_OPERATOR_KEY=
CONVERA_ENGAGEMENT_TOKEN_SECRET=
RESEND_API_KEY=
CONVERA_FROM_EMAIL=
PUBLIC_SITE_URL=https://converastrategies.com

# Recommended: separate secret for one-time portal-code hashing.
# At least 32 characters. If omitted, CONVERA_ENGAGEMENT_TOKEN_SECRET is used.
CONVERA_PORTAL_OTP_SECRET=

# Portal verification defaults
CONVERA_PORTAL_REQUIRE_EMAIL_VERIFICATION=true
CONVERA_PORTAL_OTP_TTL_MINUTES=10
CONVERA_PORTAL_OTP_COOLDOWN_SECONDS=60
CONVERA_PORTAL_MAX_ATTEMPTS=5
CONVERA_PORTAL_SESSION_HOURS=8
CONVERA_PORTAL_FROM_EMAIL=
CONVERA_PORTAL_REPLY_TO=

# Optional internal planning capacity. This is an operator-defined workload unit,
# not billable hours. Leave blank if you do not want a utilization percentage.
CONVERA_CAPACITY_UNITS=
